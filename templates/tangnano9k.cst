// Sipeed Tang Nano 9K (GW1NR-LV9QN88PC6/I5): on-board I/O template.
// Generated from YosysHQ/apicula examples/tangnano9k.cst; pin numbers cross-checked
// against sipeed/TangNano-9K-example (led/, uart/). Do not edit pins by hand.
// nextpnr-himbaechel needs a constraint for EVERY top-level port (else "Unconstrained IO");
// lines for ports that are not in the design are ignored.

// 27 MHz crystal oscillator
IO_LOC  "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// 6 LEDs, active low (0 = on), 1.8 V bank
IO_LOC  "led[0]" 10;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[1]" 11;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[2]" 13;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[3]" 14;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[4]" 15;
IO_PORT "led[4]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;
IO_LOC  "led[5]" 16;
IO_PORT "led[5]" IO_TYPE=LVCMOS18 PULL_MODE=NONE;

// 2 push buttons, active low (0 = pressed), internal pull-up, 1.8 V bank
IO_LOC  "btn_n[0]" 3;
IO_PORT "btn_n[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC  "btn_n[1]" 4;
IO_PORT "btn_n[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// USB-UART via on-board BL702 (FPGA side: uart_tx is an output)
IO_LOC  "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "uart_rx" 18;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
