  "verilog.linting.linter": "verilator",
  "verilog.linting.path": "/Users/wisstock/bio_hardware/tang_dev/.tools/oss-cad-suite/bin",
  "verilog.linting.verilator.arguments": "-sv -Wall",
  "verilog.linting.verilator.runAtFileLocation": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/.tools/oss-cad-suite/py3bin/python3",
  "files.associations": {
